[PHP]
extension_dir = "C:\Program Files\PHP\current\ext"

extension = curl
extension = fileinfo
extension = gd
extension = intl
extension = mbstring
extension = mysqli
extension = openssl
extension = pdo_mysql
extension = pdo_sqlite
extension = sqlite3
extension = zip

date.timezone = Asia/Almaty
display_errors = On
display_startup_errors = On
error_reporting = E_ALL
memory_limit = 512M
max_execution_time = 120
post_max_size = 64M
upload_max_filesize = 32M

[Session]
session.use_strict_mode = 1
session.cookie_httponly = 1
session.cookie_samesite = Lax

